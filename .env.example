# ── Supabase ────────────────────────────────────────────────
# Project Settings → API. The anon key is safe in the client bundle (RLS
# guards everything). The service role key is ONLY for Supabase Edge
# Functions — never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── Site ────────────────────────────────────────────────────
# Live domain — canonical URLs, sitemap.xml, robots.txt, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.traveltrails.agency

# ── Public enquiry form (legacy, Phase 2 replaces with an Edge Function) ──
# Free key at https://web3forms.com — submissions are emailed to that inbox.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key

# ── Supabase Edge Function secrets (set with `supabase secrets set`, NOT here) ──
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
