# Get a free access key at https://web3forms.com (just an email address,
# no account needed). Submissions on the enquiry form are emailed straight
# to that inbox — no database, no server route, no backend involved.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key

# Your live domain — used for canonical URLs, sitemap.xml, robots.txt and
# JSON-LD structured data. Defaults to https://www.traveltrails.lk if unset.
NEXT_PUBLIC_SITE_URL=https://www.traveltrails.lk
