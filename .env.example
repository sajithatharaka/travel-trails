# ── Supabase ────────────────────────────────────────────────
# Project Settings → API. The anon key is safe in the client bundle (RLS
# guards everything). The service role key is ONLY for Supabase Edge
# Functions — never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── Site ────────────────────────────────────────────────────
# Live domain — canonical URLs, sitemap.xml, robots.txt, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.traveltrails.agency

# ── Cloudflare Turnstile (public form bot protection) ───────
# Site key is safe to expose. If unset, the widgets don't render and the
# edge functions reject every submission (fail-closed) — set it before
# relying on the forms in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x<site-key>

# ── Supabase Edge Function secrets ─────────────────────────
# Set with `supabase secrets set KEY=value` — NEVER put these in .env.local
# or the client bundle.
#   TURNSTILE_SECRET_KEY   — Cloudflare Turnstile secret
#   RESEND_API_KEY         — Resend API key for notification emails
#   NOTIFICATION_FROM_EMAIL — e.g. notification@traveltrails.agency
#   SUPABASE_SERVICE_ROLE_KEY / SUPABASE_URL / SUPABASE_ANON_KEY are injected
#   automatically by the Supabase Functions runtime.

# ── Supabase CLI (scripts/deploy-supabase.sh) ───────────────
# Personal access token from https://supabase.com/dashboard/account/tokens.
SUPABASE_ACCESS_TOKEN=sbp_<token>
